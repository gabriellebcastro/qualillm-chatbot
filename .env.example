# Copie para .env e preencha. NUNCA versione o .env real.

# --- Chaves de API (preencha só as que for usar) ---
# DeepSeek: bot e simulador. Anthropic e OpenAI: os dois juízes.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
# Só para chaves "identity-linked": sem este id a API responde 400 mesmo com
# a chave correta. Fica no Console da Anthropic, em Settings > Workspaces.
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_API_KEY=

# --- Bot ---
# Provedor: deepseek | openai. Ajuste BOT_MODELO ao provedor escolhido.
#   deepseek -> BOT_MODELO=deepseek-v4-flash ("deepseek-chat" descontinuado em 2026-07-24;
#               o adaptador desliga o "thinking mode" do v4-flash, que vem ligado por padrão,
#               para manter o comportamento do antigo modo non-thinking)
#   openai   -> BOT_MODELO=gpt-4o (ou outro da sua conta)
BOT_PROVEDOR=deepseek
BOT_MODELO=deepseek-v4-flash
BOT_TEMPERATURA=0.3
# Limite de tokens de saída por resposta (menor = mais barato e mais rápido).
BOT_MAX_TOKENS=512

# --- Juiz (todas as categorias e o tom) ---
# Padrão da linha de comando; na interface, o juiz é escolhido na tela de
# avaliação. Os dois juízes do estudo:
#   anthropic -> JUIZ_MODELO=claude-haiku-5-5
#   openai    -> JUIZ_MODELO=gpt-6-luna
# Nenhum dos dois aceita temperature (erro 400): os adaptadores em llm/ não
# enviam o parâmetro, e o valor abaixo fica sem efeito neles.
JUIZ_PROVEDOR=anthropic
JUIZ_MODELO=claude-haiku-5-5
JUIZ_TEMPERATURA=0
# Raciocínio do juiz: "desligado" (padrão, configuração do estudo de caso)
# ou "padrao" (esforço medium nos dois juízes, só para o rejulgamento).
JUIZ_RACIOCINIO=desligado

# --- RAG ---
# Modelo de embeddings multilíngue (baixado automaticamente na 1a execução).
EMBEDDING_MODELO=paraphrase-multilingual-MiniLM-L12-v2
# Nº de trechos de política recuperados por turno (menor = menos tokens de entrada).
RAG_K=4

# --- Data de referência ("hoje" do sistema) ---
# DEIXE VAZIO. Sem valor, o sistema usa o dia real — necessário para que as
# datas ofertadas ao cliente (vencimento à vista, 1ª parcela) sejam datas
# futuras de verdade. Com uma data fixa aqui, o bot volta a ofertar datas
# passadas conforme o tempo avança.
# Preencha SÓ para reproduzir uma execução antiga exatamente como ela rodou.
# O perfil das dívidas não depende disto: `dias_atraso` é fixo no seed e não
# envelhece (ver "Modelo temporal" em dados/regras.py).
# DATA_REFERENCIA=2026-07-16

# --- Testes de consistência ---
# Nº padrão de vezes que a mesma entrada é executada (reexecutar.py e o teste
# de consistência em tests/). Cada execução chama a API real do bot.
N_EXECUCOES_PADRAO=5

# --- Simulador de cliente (testes de cenário conversacional) ---
# Por padrão usa o mesmo provedor/modelo do bot. Só mude se quiser que o
# cliente simulado seja interpretado por outro provedor.
# SIMULADOR_PROVEDOR=deepseek
# SIMULADOR_MODELO=deepseek-v4-flash
